<UserControl x:Class="OmniHub.App.Wpf.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" SizeChanged="OnSizeChanged">
    <Grid x:Name="Root">

        <!-- Ambient bloom behind the dial. Sized in code against the control, and the only
             glow left in the app: it belongs to a single hero element rather than being
             sprayed across every card, which is what made the earlier UI read as cheap. -->
        <Ellipse x:Name="GlowEllipse" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop" Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Decorative orbital rings. No data encoded; they keep the dial alive while the
             reading is static, and they stop entirely under reduced motion. -->
        <Ellipse x:Name="OrbitRingOuter" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="1,7" Opacity="0.45" Fill="Transparent">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="OrbitOuterRotate"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbitRingInner" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5"
                 Stroke="{StaticResource AccentBrush}" StrokeThickness="1" StrokeDashArray="4,14" Opacity="0.25" Fill="Transparent">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="OrbitInnerRotate"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Graduation marks, drawn in code so they scale with the control. The detail that
             makes a dial read as an instrument rather than a progress circle. -->
        <Canvas x:Name="TickCanvas" IsHitTestVisible="False"/>

        <Ellipse x:Name="TrackEllipse" Stroke="{StaticResource BorderBrush}" Fill="Transparent"/>

        <Path x:Name="ProgressPath" Fill="Transparent"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <DropShadowEffect x:Name="ProgressGlow" ShadowDepth="0" BlurRadius="16" Opacity="0.55"
                                  Color="{DynamicResource AccentColor}"/>
            </Path.Effect>
        </Path>

        <!-- Bright dot riding the end of the arc: gives the sweep a leading edge, so a change
             reads as movement rather than the ring simply being a different length. -->
        <Ellipse x:Name="TipDot" Width="0" Height="0" IsHitTestVisible="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <StackPanel x:Name="CenterPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ValueText" Style="{StaticResource BigNumberText}" FontSize="40"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="LabelText" Style="{StaticResource SubHeadingText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
