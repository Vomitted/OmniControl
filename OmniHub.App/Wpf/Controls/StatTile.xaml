<UserControl x:Class="OmniHub.App.Wpf.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MinWidth/MinHeight rather than fixed Width/Height. The fixed 176x104 clipped any
         value wider than about eight monospace characters, which is how "BIOS Auto" was
         rendering as "BIOS Aut" and the mode subtitle was losing its last line. A tile whose
         content is a live reading cannot assume the reading's width. -->
    <Border Style="{StaticResource CardBorderStyle}" MinWidth="176" MinHeight="104"
            Padding="16,13" Margin="0,0,12,12">
        <Grid>
            <Border Style="{StaticResource CardSheenStyle}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubHeadingText}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ValueText" Style="{StaticResource BigNumberText}" FontSize="27"
                           RenderTransformOrigin="0,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="ValueScale" ScaleX="1" ScaleY="1"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <!-- Wraps instead of overflowing: subtitles here are short sentences
                     ("Floor-protected, re-applied"), not single tokens. -->
                <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" FontSize="11"
                           TextWrapping="Wrap" MaxWidth="220" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
