<UserControl x:Class="OmniHub.App.Wpf.Controls.WaveformChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged">
    <!-- Elements are declared once and only their geometry is replaced on each push. The
         previous version cleared Root and allocated fresh Paths, brushes and gradient stops
         every two seconds forever, which is real garbage for a control that redraws the same
         four shapes each time. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <Path x:Name="GridPath" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
        <Path x:Name="FillPath" IsHitTestVisible="False"/>
        <Path x:Name="StrokePath" StrokeThickness="2" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect x:Name="StrokeGlow" ShadowDepth="0" BlurRadius="10" Opacity="0.45"/>
            </Path.Effect>
        </Path>
        <!-- Leading-edge marker: shows where "now" is, so the trace reads as advancing rather
             than as a static shape that occasionally changes. -->
        <Ellipse x:Name="TipDot" Width="7" Height="7" IsHitTestVisible="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
