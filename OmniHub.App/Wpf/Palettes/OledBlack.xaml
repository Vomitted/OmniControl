<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OLED BLACK. True #000000 ground: on an OLED panel those pixels are switched
         off, so the app edge and the chassis edge become the same black. Surfaces are
         lifted only barely; the hairline border defines a card's shape, not its fill. -->

    <Color x:Key="BackgroundColor">#FF000000</Color>
    <Color x:Key="PanelColor">#FF0A0B0D</Color>
    <Color x:Key="PanelAltColor">#FF121419</Color>
    <Color x:Key="PanelHoverColor">#FF1A1D23</Color>
    <Color x:Key="BorderColor">#FF1E222A</Color>
    <Color x:Key="BorderStrongColor">#FF2E343F</Color>

    <!-- Never #FFFFFF on true black: glyph edges bloom and small text goes soft. -->
    <Color x:Key="TextPrimaryColor">#FFE4E7EC</Color>
    <Color x:Key="TextMutedColor">#FF7B8493</Color>
    <Color x:Key="TextFaintColor">#FF4C5563</Color>

    <Color x:Key="AccentColor">#FF22D3EE</Color>
    <Color x:Key="AccentDimColor">#3822D3EE</Color>
    <Color x:Key="AccentSoftColor">#1E22D3EE</Color>

    <Color x:Key="GoodColor">#FF34D399</Color>
    <Color x:Key="WarnColor">#FFF5B544</Color>
    <Color x:Key="DangerColor">#FFFF4D6D</Color>

    <!-- Per-metric accents. Each dashboard card gets its own hue for identity, which is what
         makes a dense readout scannable: you learn the shape of the screen by colour and
         stop reading labels. This is the one deliberate exception to "colour means state",
         and it works only because the THERMAL card is excluded. That one still recolours
         from the live reading, so a real warning never competes with decoration. -->
    <Color x:Key="MetricCpuColor">#FF22D3EE</Color>
    <Color x:Key="MetricMemColor">#FF34D399</Color>
    <Color x:Key="MetricGpuColor">#FF60A5FA</Color>

    <!-- Top-edge highlight on cards. A 1px lighter line along the top edge reads as
         "lit from above" and is most of what separates a designed surface from a flat
         rectangle; on a black ground it is the cheapest available depth cue. -->
    <Color x:Key="CardTopHighlightColor">#14FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF12151A</Color>

    <!-- Caption/frame colours handed to DWM so the OS title bar matches the app. -->
    <Color x:Key="CaptionColor">#FF000000</Color>
    <Color x:Key="CaptionTextColor">#FFE4E7EC</Color>

</ResourceDictionary>
