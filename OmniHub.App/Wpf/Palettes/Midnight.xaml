<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MIDNIGHT. Deep blue-black rather than true black. Easier on an IPS panel, where
         #000000 shows backlight bleed and grey-shifts off-axis, and it gives the surface
         steps more room to separate. Violet accent keeps it distinct from OLED Black's
         cyan without straying into the thermal colour range. -->

    <Color x:Key="BackgroundColor">#FF0B0E17</Color>
    <Color x:Key="PanelColor">#FF131829</Color>
    <Color x:Key="PanelAltColor">#FF1A2033</Color>
    <Color x:Key="PanelHoverColor">#FF232B42</Color>
    <Color x:Key="BorderColor">#FF262E45</Color>
    <Color x:Key="BorderStrongColor">#FF3A4460</Color>

    <Color x:Key="TextPrimaryColor">#FFE8EAF2</Color>
    <Color x:Key="TextMutedColor">#FF8A93AD</Color>
    <Color x:Key="TextFaintColor">#FF59627C</Color>

    <Color x:Key="AccentColor">#FF8B7CF6</Color>
    <Color x:Key="AccentDimColor">#388B7CF6</Color>
    <Color x:Key="AccentSoftColor">#1E8B7CF6</Color>

    <Color x:Key="GoodColor">#FF48D18B</Color>
    <Color x:Key="WarnColor">#FFEBB552</Color>
    <Color x:Key="DangerColor">#FFF4685A</Color>
    <!-- Per-metric card accents; see OledBlack.xaml for the rationale. -->
    <Color x:Key="MetricCpuColor">#FF8B7CF6</Color>
    <Color x:Key="MetricMemColor">#FF48D18B</Color>
    <Color x:Key="MetricGpuColor">#FF60A5FA</Color>

    <Color x:Key="CardTopHighlightColor">#18FFFFFF</Color>
    <Color x:Key="GridLineColor">#FF1B2133</Color>

    <Color x:Key="CaptionColor">#FF0B0E17</Color>
    <Color x:Key="CaptionTextColor">#FFE8EAF2</Color>

</ResourceDictionary>
