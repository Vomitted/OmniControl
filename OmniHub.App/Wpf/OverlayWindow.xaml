<Window x:Class="OmniHub.App.Wpf.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        Title="OmniHub Overlay">
    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,9" Opacity="0.88">
        <StackPanel MinWidth="128">
            <TextBlock x:Name="SourceLabel" Style="{StaticResource DataLabelText}" Text="OMNIHUB" Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TempText" Grid.Column="1" Style="{StaticResource BigNumberText}" FontSize="17" Text="--"/>
            </Grid>

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="FAN" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="FanText" Grid.Column="1" Style="{StaticResource BigNumberText}" FontSize="17" Text="--"/>
            </Grid>

            <Grid x:Name="PowerRow" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PKG" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="PowerText" Grid.Column="1" Style="{StaticResource BigNumberText}" FontSize="17" Text="--"/>
            </Grid>

            <TextBlock x:Name="StateText" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</Window>
